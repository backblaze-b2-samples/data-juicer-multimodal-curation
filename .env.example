# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region is the single source of truth; the S3 endpoint is derived as
# https://s3.<B2_REGION>.backblazeb2.com (no endpoint is hardcoded in source).
B2_REGION=your_region

# Optional: public base URL for objects in a public bucket. Leave commented for
# a private bucket (the app uses presigned URLs for downloads/previews).
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# What filled-in values look like (described, not real credentials):
#   B2_APPLICATION_KEY_ID = a ~25-char key id from the B2 dashboard
#   B2_APPLICATION_KEY    = the application key shown once when you create the key
#   B2_BUCKET_NAME        = my-multimodal-corpus
#   B2_REGION             = us-west-004  (the region in s3.<region>.backblazeb2.com)

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
